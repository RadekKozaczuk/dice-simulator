# Disable analysis for 3rd party code
[Assets/3rdParty/**/*.cs]
dotnet_diagnostic.*.severity = none
dotnet_analyzer_diagnostic.severity = none

[Packages/**/*.cs]
dotnet_diagnostic.*.severity = none
dotnet_analyzer_diagnostic.severity = none

# Disable (or sadly just suppress) custom analyzers for anything but our code
[*]
dotnet_analyzer_diagnostic.category-RAD.severity = none
[Assets/Scripts/**.cs]
dotnet_analyzer_diagnostic.category-RAD.severity = error

#### C# Coding Conventions ####

# var preferences
csharp_style_var_elsewhere = false:error
csharp_style_var_for_built_in_types = false:error
csharp_style_var_when_type_is_apparent = true:error

# Omit suggesting explicit accessibility (IDE0040: Add accessibility modifiers)
dotnet_style_require_accessibility_modifiers = omit_if_default


#######################################################################################################
#######################################################################################################
#### Rider Specific (https://www.jetbrains.com/help/rider/Reference__Code_Inspections_CSHARP.html) ####

##############################################################################
### EditorConfig properties for C#: Blank Lines ==============================

csharp_blank_lines_around_invocable = 1
csharp_remove_blank_lines_near_braces_in_code = true

##############################################################################
### EditorConfig properties for C#: Blank Lines ==============================
### https://www.jetbrains.com/help/rider/EditorConfig_CSHARP_BlankLinesPageScheme.html

# these values means MINIMAL amount of lines allowed
csharp_blank_lines_around_region = 1
csharp_blank_lines_inside_region = 0
csharp_blank_lines_before_single_line_comment = 0
csharp_keep_blank_lines_in_declarations = 1
csharp_remove_blank_lines_near_braces_in_declarations = true
csharp_blank_lines_after_start_comment = 0
csharp_blank_lines_between_using_groups = 0
csharp_blank_lines_after_using_list = 1
csharp_blank_lines_around_namespace = 0
csharp_blank_lines_inside_namespace = 0
csharp_blank_lines_after_file_scoped_namespace_directive = 1
csharp_blank_lines_around_type = 1
csharp_blank_lines_around_single_line_type = 1
csharp_blank_lines_inside_type = 0

# around fild with a comment or declated over a multiple line, comments below the line of code in question counts as well
csharp_blank_lines_around_field = 1
csharp_blank_lines_around_single_line_field = 0
csharp_blank_lines_around_property = 0
csharp_blank_lines_around_single_line_property = 0
csharp_blank_lines_around_auto_property = 1
csharp_blank_lines_around_single_line_auto_property = 0
csharp_blank_lines_around_accessor = 0
csharp_blank_lines_around_single_line_accessor = 0
csharp_blank_lines_around_single_line_invocable = 1
csharp_keep_blank_lines_in_code = 1
csharp_blank_lines_around_local_method = 1
csharp_blank_lines_around_single_line_local_method = 1
csharp_blank_lines_before_control_transfer_statements = 0
csharp_blank_lines_after_control_transfer_statements = 1
csharp_blank_lines_before_block_statements = 0 # this must be 0 as it forces new line above every for-loop block
csharp_blank_lines_after_block_statements = 1
csharp_blank_lines_before_multiline_statements = 0
csharp_blank_lines_after_multiline_statements = 0
csharp_blank_lines_around_block_case_section = 0
csharp_blank_lines_around_multiline_case_section = 0
csharp_blank_lines_before_case = 0
csharp_blank_lines_after_case = 0


##############################################################################
### EditorConfig properties for C#: Braces Layout ==============================
### https://www.jetbrains.com/help/rider/EditorConfig_CSHARP_BracesPageSchema.html
csharp_type_declaration_braces = next_line
csharp_brace_style = next_line
csharp_indent_inside_namespace = true
csharp_invocable_declaration_braces = next_line
csharp_anonymous_method_declaration_braces = next_line
csharp_accessor_owner_declaration_braces = next_line
csharp_accessor_declaration_braces = next_line
csharp_case_block_braces = next_line
csharp_initializer_braces = next_line
csharp_use_continuous_indent_inside_initializer_braces = true
csharp_other_braces = next_line
csharp_allow_comment_after_lbrace = false
csharp_empty_block_style = together_same_line


###############################################################################
### EditorConfig properties for C#: Syntax Style ==============================
### https://www.jetbrains.com/help/rider/EditorConfig_CSHARP_CSharpCodeStylePageImplSchema.html
csharp_for_built_in_types = use_explicit_type
csharp_for_simple_types = use_var_when_evident
csharp_for_other_types = use_var_when_evident
csharp_use_roslyn_logic_for_evident_types = true
csharp_prefer_separate_deconstructed_variables_declaration = false
csharp_prefer_explicit_discard_declaration = false
csharp_instance_members_qualify_members = none
csharp_instance_members_qualify_declared_in = this_class
csharp_static_members_qualify_with = current_type
csharp_static_members_qualify_members = none
csharp_builtin_type_reference_style = use_keyword
csharp_builtin_type_reference_for_member_access_style = use_keyword
csharp_builtin_type_apply_to_native_integer = true
# this, if true, will convert this List<int> list; into System.Collections.Generic.List<int> list;
csharp_prefer_qualified_reference = false
# this will move usings into namespace if allowed
csharp_add_imports_to_deepest_scope = false
dotnet_sort_system_directives_first = true
# no idea what it does
csharp_qualified_using_at_nested_scope = true
csharp_allow_alias = true
csharp_can_use_global_alias = true
csharp_default_private_modifier = implicit
csharp_default_internal_modifier = implicit
csharp_modifiers_order = public, protected, internal, private, file, static, extern, new, virtual, abstract, sealed, override, readonly, unsafe, volatile, async, required, partial
csharp_arguments_skip_single = true
csharp_arguments_literal = positional
csharp_arguments_string_literal = positional
csharp_arguments_named = positional
csharp_arguments_anonymous_function = positional
csharp_arguments_other = positional
csharp_parentheses_redundancy_style = always
csharp_parentheses_non_obvious_operations = none
csharp_parentheses_group_non_obvious_operations = none
csharp_parentheses_same_type_operations = true
csharp_braces_for_ifelse = not_required
csharp_braces_for_for = not_required
csharp_braces_for_foreach = not_required
csharp_braces_for_while = not_required
csharp_braces_for_dowhile = not_required
csharp_braces_for_using = not_required
csharp_braces_for_lock = not_required
csharp_braces_for_fixed = not_required
csharp_braces_redundant = true
csharp_method_or_operator_body = expression_body
csharp_local_function_body = expression_body
csharp_constructor_or_destructor_body = expression_body
csharp_accessor_owner_body = expression_body
csharp_namespace_body = block_scoped
csharp_use_heuristics_for_body_style = true
csharp_force_attribute_style = separate
csharp_trailing_comma_in_multiline_lists = false
csharp_trailing_comma_in_singleline_lists = false
csharp_object_creation_when_type_evident = target_typed
csharp_object_creation_when_type_not_evident = explicitly_typed
csharp_default_value_when_type_evident = default_literal
csharp_default_value_when_type_not_evident = default_literal
csharp_null_checking_pattern_style = not_null_pattern


###############################################################################
### EditorConfig properties for C#: Tabs, Indents, Alignment ==============================
### https://www.jetbrains.com/help/resharper/EditorConfig_CSHARP_CSharpIndentStylePageSchema.html 
csharp_indent_style = space
csharp_indent_size = 4
csharp_tab_width = 4
csharp_continuous_indent_multiplier = 1

## Nested statements
csharp_indent_nested_usings_stmt = true
csharp_indent_nested_fixed_stmt = true
csharp_indent_nested_lock_stmt = true
csharp_indent_nested_for_stmt = true
csharp_indent_nested_foreach_stmt = true
csharp_indent_nested_while_stmt = true

## Parenthesis﻿
# no idea what it does
csharp_use_continuous_indent_inside_parens = true
csharp_indent_method_decl_pars = inside
csharp_indent_primary_constructor_decl_pars = inside
csharp_indent_invocation_pars = inside
csharp_indent_statement_pars = inside
csharp_indent_typeparam_angles = inside
csharp_indent_typearg_angles = inside
csharp_indent_pars = inside

## Preprocessor directives
csharp_indent_preprocessor_if = no_indent
csharp_indent_preprocessor_region = no_indent
csharp_indent_preprocessor_other = no_indent

## Other indents
csharp_indent_switch_labels = true
csharp_outdent_statement_labels = true
csharp_indent_type_constraints = true
csharp_stick_comment = false

# no idea what it does
csharp_place_comments_at_first_column = false

# no idea what it does
csharp_use_indent_from_previous_element = false
csharp_indent_braces_inside_statement_conditions = true

## Align multiline constructs
csharp_alignment_tab_fill_style = use_spaces

# no idea what it does
csharp_allow_far_alignment = false

# false because sometimes method may be pretty long, true would move parameters right below "("
#public delegate void ChangeState(GameState requested, int[]? additionalScenesToLoad = null,
#    int[]? additionalScenesToUnload = null, (StateTransitionParameter key, object value)[]? parameters = null,
#    int[]? scenesToSynchronize = null);
csharp_align_multiline_parameter = false

csharp_align_multiline_extends_list = true
csharp_align_linq_query = true

# this sometimes looks weird when set to true
csharp_align_multiline_binary_expressions_chain = false
csharp_outdent_binary_ops = false

# this looks weird for both but true overall looks better
# true produces for example this:
#questText = await db.GetLocalizedStringAsync("GameUI", 
#                        "game.quest.open.chest")
#                    .Task;
# when false would do this:
#UIData.ActiveInventoryFull = _elementsViews
#    .SubArray(0, Constants.ActiveSkillsNumber)
#    .All(s => s);
csharp_align_multiline_calls_chain = true #RADEK

csharp_outdent_dots = false

# false because true may sometimes push the parenthesis too far right
#ecb.SetComponent(player, new LocalTransform
#{ <-- when false         { <-- when true
#    Position = new float3(SpawnPointsService.SpawnPoint, 0), <-- when false
csharp_align_multiline_array_and_object_initializer = false

csharp_align_multiline_switch_expression = false
csharp_align_multiline_property_pattern = false
csharp_align_multiline_list_pattern = true
csharp_align_multiline_binary_patterns = true
csharp_outdent_binary_pattern_ops = true

# false because setting it to true may sometimes push the parenthesis too far right
# SceneManager.sceneLoaded += (scene, _) =>
# { <-- when false            { <-- when true
csharp_indent_anonymous_method_block = false

# false becasue sometimes we want to put the first parameter below
# 1 => Unity.Physics.SphereCollider.Create(
#     new SphereGeometry
#     {
csharp_align_first_arg_by_paren = false

csharp_align_multiline_argument = false
csharp_align_tuple_components = true

# false because tenary if-else statements sometimes does not look very good
#int actualNpcCount = type == CharacterType.Wizard 
#                         ? math.max(0, npcCount - playerCount)
#                         : npcCount;
csharp_align_multiline_expression = false

csharp_align_multiline_statement_conditions = true
csharp_align_multiline_for_stmt = true
csharp_align_multiple_declaration = true
csharp_align_multline_type_parameter_list = true
csharp_align_multline_type_parameter_constrains = true
csharp_outdent_commas = true
csharp_align_multiline_comments = true
csharp_indent_raw_literal_string = align

## Align similar code in columns
# for example:
# int i   = 5;
# int abc = 6;
csharp_int_align_fix_in_adjacent = false
csharp_int_align = false
csharp_int_align_fields = false
csharp_int_align_properties = false
csharp_int_align_methods = false
csharp_int_align_parameters = false
csharp_int_align_variables = false
csharp_int_align_assignments = false
csharp_int_align_property_patterns = false
csharp_int_align_nested_ternary = false
csharp_int_align_invocations = false
csharp_int_align_binary_expressions = false
csharp_int_align_comments = true
csharp_int_align_switch_sections = false
csharp_int_align_switch_expressions = false


###############################################################################
### EditorConfig properties for C#: Line Breaks ==============================
# https://www.jetbrains.com/help/rider/EditorConfig_CSHARP_LineBreaksPageSchema.html
csharp_keep_user_linebreaks = true
# more generic (some attributes are fallback attributes I guees, or used when more dedicated aren't present)
csharp_keep_existing_arrangement = false
csharp_keep_existing_linebreaks = false
csharp_keep_existing_attribute_arrangement = false
csharp_keep_existing_declaration_parens_arrangement = true
csharp_keep_existing_primary_constructor_declaration_parens_arrangement = false
csharp_max_line_length = 120
csharp_wrap_before_comma = false
csharp_wrap_before_eq = true
csharp_special_else_if_treatment = true
csharp_insert_final_newline = false
csharp_max_attribute_length_for_same_line = 5 # I assume this should be set to infinity

csharp_place_type_attribute_on_same_line = never
csharp_place_method_attribute_on_same_line = never 
csharp_place_accessorholder_attribute_on_same_line = never
csharp_place_accessor_attribute_on_same_line = never 
csharp_place_field_attribute_on_same_line = never
csharp_place_record_field_attribute_on_same_line = never
csharp_place_attribute_on_same_line = never

# probably wrap is better as chop may not really scale well for longer methods
# also it should not be really based on the number of parameters but rather on the number of columns
csharp_wrap_parameters_style = wrap_if_long

# defacto does not matter as sometimes parameters are very small
# ideally, should be based on line number not the parameter count
csharp_max_formal_parameters_on_line = 10
csharp_wrap_before_declaration_lpar = false
csharp_wrap_after_declaration_lpar = false
csharp_wrap_before_declaration_rpar = false
csharp_place_constructor_initializer_on_same_line = true
csharp_wrap_primary_constructor_parameters_style = wrap_if_long
csharp_max_primary_constructor_parameters_on_line = 6
csharp_keep_existing_primary_constructor_declaration_parens_arrangement = true
csharp_wrap_before_primary_constructor_declaration_lpar = true
csharp_wrap_after_primary_constructor_declaration_lpar = false
csharp_wrap_before_primary_constructor_declaration_rpar = false

# do we really want to keep it?
csharp_keep_existing_expr_member_arrangement = true
csharp_place_expr_method_on_single_line = if_owner_is_single_line
csharp_place_expr_property_on_single_line = if_owner_is_single_line
csharp_place_expr_accessor_on_single_line = if_owner_is_single_line
csharp_wrap_before_arrow_with_expressions = false
csharp_place_type_constraints_on_same_line = true
csharp_wrap_before_first_type_parameter_constraint = false
csharp_wrap_multiple_type_parameter_constraints_style = chop_always
csharp_wrap_before_type_parameter_langle = false
csharp_wrap_before_extends_colon = false
csharp_wrap_extends_list_style = wrap_if_long
csharp_keep_existing_declaration_block_arrangement = false
csharp_place_abstract_accessorholder_on_single_line = true
csharp_place_simple_declaration_blocks_on_single_line = true
csharp_place_simple_accessorholder_on_single_line = true
csharp_place_accessor_with_attrs_holder_on_single_line = true

csharp_place_simple_accessor_on_single_line = true

csharp_place_simple_method_on_single_line = true

csharp_keep_existing_enum_arrangement = false
csharp_max_enum_members_on_line = 1

csharp_place_simple_enum_on_single_line = true
csharp_wrap_enum_declaration = chop_if_long
csharp_new_line_before_else = true
csharp_new_line_before_while = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_wrap_for_stmt_header_style = chop_if_long
csharp_wrap_multiple_declaration_style = chop_if_long
csharp_keep_existing_embedded_arrangement = false
csharp_place_simple_embedded_statement_on_same_line = never
csharp_place_simple_case_statement_on_same_line = never
csharp_keep_existing_embedded_block_arrangement = false

csharp_place_simple_embedded_block_on_same_line = false

# probably should be false
csharp_place_simple_blocks_on_single_line = true

csharp_place_simple_anonymousmethod_on_single_line = true

csharp_keep_existing_switch_expression_arrangement = false
csharp_place_simple_switch_expression_on_single_line = false
csharp_wrap_switch_expression = chop_always

csharp_keep_existing_property_patterns_arrangement = false
csharp_place_simple_property_pattern_on_single_line = true
csharp_wrap_property_pattern = wrap_if_long
csharp_keep_existing_list_patterns_arrangement = true
csharp_place_simple_list_pattern_on_single_line = true

# defacto does not matter as we disable list wrapping highlight anyway
csharp_wrap_list_pattern = chop_if_long

csharp_keep_existing_initializer_arrangement = false
csharp_place_simple_initializer_on_single_line = true

# defacto does not matter as there will be lists like f.e. 
# List<int> batches = new() { 5, 8, 7, 6, 4, 9, 3, 10, 2, 8, 6, 7, 5, 4, 16 };
# that has 15 elements and still fits perefectly fine in one line
csharp_max_initializer_elements_on_line = 20
csharp_wrap_object_and_collection_initializer_style = chop_if_long

# as with lists, defacto it should simply not be under bot controll
# it cannot be too long as we want arrays like this to exist
#internal static readonly string[] ConfigPaths =
#{
#    "Assets/Settings/Configs/Boot",
#    "Assets/Settings/Configs/Core",
#    "Assets/Settings/Configs/DataOriented",
#    "Assets/Settings/Configs/GameLogic",
#    "Assets/Settings/Configs/Shared"
csharp_max_array_initializer_elements_on_line = 20
csharp_wrap_array_initializer_style = wrap_if_long
csharp_wrap_arguments_style = wrap_if_long

# defacto does not matter as sometimes parameters are very small and fir perfectly within the declaration
# ideally, it should be assosiated with line number not argument count
csharp_max_invocation_arguments_on_line = 20
csharp_keep_existing_invocation_parens_arrangement = false
csharp_wrap_before_invocation_lpar = false
csharp_wrap_after_invocation_lpar = false
csharp_wrap_before_invocation_rpar = false
csharp_wrap_after_dot_in_method_calls = false
csharp_wrap_chained_method_calls = chop_if_long
csharp_wrap_before_first_method_call = false
csharp_wrap_after_property_in_chained_method_calls = false
csharp_wrap_before_binary_opsign = true
csharp_wrap_chained_binary_expressions = chop_if_long
csharp_wrap_before_binary_pattern_op = true
csharp_wrap_chained_binary_patterns = chop_if_long
csharp_force_chop_compound_if_expression = false
csharp_force_chop_compound_while_expression = false
csharp_force_chop_compound_do_expression = false
csharp_wrap_before_ternary_opsigns = true
csharp_wrap_ternary_expr_style = chop_if_long
csharp_nested_ternary_style = expanded
csharp_wrap_linq_expressions = chop_if_long
csharp_wrap_before_linq_expression = false
csharp_place_linq_into_on_new_line = false
csharp_wrap_verbatim_interpolated_strings = wrap_if_long

#########################################################################
### Common Practices and Code Improvements ==============================
### This category groups inspections that hunt for issues that mainly affect code readability.

# Access to a static member of a type via a derived type
access_to_static_member_via_derived_type_highlighting = error

# Actual number of bytes read by 'Stream.Read()' is ignored
stream_read_return_value_ignored_highlighting = error

# Add explicit 'return' or 'continue' before local functions
separate_local_functions_with_jump_statement_highlighting = error

# Annotation duplicate in hierarchy
annotation_redundancy_in_hierarchy_highlighting = error

# Auto-property can be made get-only (non-private accessibility)
auto_property_can_be_made_get_only_global_highlighting = error

# Auto-property can be made get-only (private accessibility)
auto_property_can_be_made_get_only_local_highlighting = error

# Base member has 'params' parameter, but the overrider does not have it
base_member_has_params_highlighting = error

# Can simplify 'Contains' before 'Add'
can_simplify_set_adding_with_single_call_highlighting = error

# Cast expression can be replaced with explicit type arguments
can_replace_cast_with_type_argument_highlighting = error

# Cast expression can be replaced with explicit variable type
can_replace_cast_with_variable_type_highlighting = error

# Cast expression can be replaced with lambda return type
can_replace_cast_with_lambda_return_type_highlighting = error

# Cast expression can be replaced with simplified type arguments = error
can_replace_cast_with_shorter_type_argument_highlighting = error

# Change lock field type to 'System.Threading.Lock'
change_field_type_to_system_threading_lock_highlighting = error

# Check for reference equality instead
check_for_reference_equality_instead_1_highlighting = error

# Check for reference equality instead
check_for_reference_equality_instead_3_highlighting = error

# Check for reference equality instead
check_for_reference_equality_instead_2_highlighting = error

# Check for reference equality instead
check_for_reference_equality_instead_4_highlighting = error

# Class can be made sealed (non-inheritable) (non-private accessibility)
class_can_be_sealed_global_highlighting = error

# Class can be made sealed (non-inheritable) (private accessibility)
class_can_be_sealed_local_highlighting = error

# Confusing body-like statement
misleading_body_like_statement_highlighting = error

# Container nullability attribute usage with declaration of non-container type
container_annotation_redundancy_highlighting = error

# Convert 'if do while' into 'while'
convert_if_do_to_while_highlighting = error

# Convert 'if' into '||'
convert_if_to_or_expression_highlighting = error

# Convert local variable or field into constant (non-private accessibility)
convert_to_constant_global_highlighting = error

# Convert local variable or field into constant (private accessibility)
convert_to_constant_local_highlighting = error

# Declaration nullability inferred (parameter is inferred to be not null)
annotate_not_null_parameter_highlighting = error

# Declaration nullability inferred (parameter is inferred to be nullable)
annotate_can_be_null_parameter_highlighting = error

# Declaration nullability inferred (type member is inferred to be not null)
annotate_not_null_type_member_highlighting = error

# Declaration nullability inferred (type member is inferred to be nullable)
annotate_can_be_null_type_member_highlighting = error

# Dictionary item removal can be simplified with single 'Remove'
can_simplify_dictionary_removing_with_single_call_highlighting = error

# Dictionary lookup can be simplified with 'GetValueOrDefault'
can_simplify_dictionary_try_get_value_with_get_value_or_default_highlighting = error

# Dictionary lookup can be simplified with 'TryAdd' = error
can_simplify_dictionary_lookup_with_try_add_highlighting = error

# Dictionary lookup can be simplified with 'TryGetValue'
can_simplify_dictionary_lookup_with_try_get_value_highlighting = error

# Empty statement is redundant
empty_statement_highlighting = error

# Extract common property pattern
extract_common_property_pattern_highlighting = error

# Field can be made readonly (non-private accessibility)
field_can_be_made_read_only_global_highlighting = error

# Field can be made readonly (private accessibility)
field_can_be_made_read_only_local_highlighting = error

# Get-only auto-property is never assigned
unassigned_get_only_auto_property_highlighting = error

# Invert condition
invert_condition_1_highlighting = error

# Iteration variable can be declared with a more specific type
more_specific_foreach_variable_type_available_highlighting = error

# Join local variable declaration and assignment
join_declaration_and_initializer_highlighting = error

# Local function can be made static
local_function_can_be_made_static_highlighting = error

# Local variable has too wide declaration scope
too_wide_local_variable_scope_highlighting = error

# Make constructor in abstract class protected
public_constructor_in_abstract_class_highlighting = error

# Member can be made private (non-private accessibility)
member_can_be_private_global_highlighting = error

# Member can be made private (private accessibility)
member_can_be_private_local_highlighting = error

# Member can be made protected (non-private accessibility)
member_can_be_protected_global_highlighting = error

# Member can be made protected (private accessibility)
member_can_be_protected_local_highlighting = error

# Member can be made static (shared) (non-private accessibility)
member_can_be_made_static_global_highlighting = error

# Member can be made static (shared) (private accessibility)
member_can_be_made_static_local_highlighting = error

# Member or type can be made internal (friend)
member_can_be_internal_highlighting = error

# Method has async overload
method_has_async_overload_highlighting = error

# Method has async overload with cancellation support
method_has_async_overload_with_cancellation_highlighting = error

# Method supports cancellation
method_supports_cancellation_highlighting = error

# Missing XML comment for private or internal type or member
internal_or_private_member_not_documented_highlighting = error

# Multiple nullable attributes usage
multiple_nullable_attributes_usage_highlighting = error

# Nested string interpolation can be inlined
nested_string_interpolation_highlighting = error

# Nullability attribute usage with declaration of void or value type
annotation_redundancy_at_value_type_highlighting = error

# Nullability attribute used with declaration that cannot be directly referenced from other code
not_observable_annotation_redundancy_highlighting = error

# Parameter can be declared with the base type
# Must be disabled as we sometimes want specifc types f.e.:
# Function below could take GameObject as a parameter but by narrowing it down to a Camera
# we sent much more clearer message to the code users
